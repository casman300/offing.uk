# Offing environment settings.
#
# As committed, this file is ready for local dev: `cp .env.example .env`,
# then `php artisan key:generate`. CI copies it the same way.
#
# Staging and production: create <public_html>/../laravel/.env by hand on the
# host, once, before the first deploy (the deploy refuses to run without it).
# Each "Staging/production:" note below says what to put there instead. Every
# host gets its own keys and its own database; never copy a key between hosts.
#
# Two things to know when editing a host's .env:
# - Deploys run `config:cache`, so an edit only takes effect after
#   `"$PHP" artisan config:cache` over SSH (PHP="$(bash deploy/find-php.sh)"),
#   or the next deploy.
# - The production deploy runs `source .env` in bash for its database
#   snapshot, so every value must also be valid shell. Wrap anything with
#   spaces or $ ! & # in single quotes (literal to both bash and Laravel).
#
# Run the commands below from a checkout with `composer install` done, or on
# the host once the app is deployed, as "$PHP" artisan ….

# --- App -------------------------------------------------------------------

APP_NAME=Offing

# Staging: staging. Production: production.
APP_ENV=local

# Staging/production: run `php artisan key:generate --show` and paste the
# output. Generate it before the first deploy. Never change it afterwards:
# that signs everyone out and breaks signed links in emails already sent.
APP_KEY=

# Staging/production: false (staging is on the public internet too).
APP_DEBUG=true

# Staging/production: the exact https URL, e.g. https://offing.uk. Passkeys
# belong to this host, so changing it later invalidates everyone's passkeys.
# It also sets HSTS, feed IDs and every link in emails.
APP_URL=http://localhost

# Keep UTC everywhere: times are stored in UTC and shown in each user's
# profile timezone.
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Staging/production: required. The absolute path of public_html (the same
# path as the STAGING_/PRODUCTION_DEPLOY_PATH Actions secret). The app lives
# in a private sibling directory next to it (see the deploy workflows and
# bootstrap/app.php). Leave unset for local dev.
# PUBLIC_PATH=/absolute/path/to/public_html

# Comma-separated emails allowed into /admin (feature flags, users, outbox).
# Create the first account with `php artisan user:create you@example.com You`.
ADMIN_EMAILS=

# --- Database --------------------------------------------------------------

# Staging/production: mysql, with a separate database and user per host
# (create them in the 20i control panel). Quote DB_PASSWORD in single quotes.
DB_CONNECTION=sqlite
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

# --- Mail ------------------------------------------------------------------

# "log" writes mail to storage/logs/laravel.log instead of sending it (or run
# Mailpit locally: smtp, 127.0.0.1, port 1025, encryption null).
# Staging/production: smtp, with a 20i mailbox. Take the SMTP host from the
# 20i panel; use port 587 with tls. Without real mail nobody can sign in, so
# request a magic link after every change to check it.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
# Should be the mailbox above, or mail gets flagged as spam.
MAIL_FROM_ADDRESS="hello@example.com"
# Staging: "Offing (staging)", so it's obvious which host sent an email.
MAIL_FROM_NAME="${APP_NAME}"

# --- Sessions, queue, cache ------------------------------------------------
# Same on every host: 20i has no Redis or Memcached, and the scheduler
# drains the database queue.

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Staging/production: true (https-only session cookie). Leave it off over
# plain http locally, or you can't stay signed in.
# SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Logging ---------------------------------------------------------------

# Staging/production: LOG_STACK=daily (one file per day, kept for
# LOG_DAILY_DAYS). Production: LOG_LEVEL=warning.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Optional features (generate a separate set for each host) -------------

# Cron dead-man's switch. Create one check per host on healthchecks.io
# (period 1 minute, grace about 10 minutes) and paste its ping URL. The
# scheduler pings it every minute, so you get an email if cron stops.
#
# The scheduler itself needs a cron entry on the host (20i: Advanced >
# Scheduled Tasks), every minute, with the exact command the deploy log
# prints at the end: /path/to/php /path/to/laravel/artisan schedule:run.
# Without it no email is sent at all (magic links are queued).
HEALTHCHECK_URL=

# HTTPS-only for every subdomain of APP_URL's host too, for a year, in every
# browser that visits. Leave false unless ALL of them serve https (a NAS or
# router on http://something.yourdomain would stop opening).
HSTS_INCLUDE_SUBDOMAINS=false

# Web Push for reminders: run `php artisan push:keys` and paste its three
# lines here. Push stays hidden until both keys are set. Changing them later
# breaks every device's subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@offing.uk

# Connect Claude (spec §12): run `php artisan connect-claude:keys` and paste
# both lines, double quotes included. Changing them later signs everyone's
# Claude out. Never commit them.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=
# Hosts allowed to register as OAuth clients (comma-separated). The default
# allows Claude, ChatGPT and localhost (Claude Code and other desktop clients).
# MCP_REDIRECT_DOMAINS=https://claude.ai,https://claude.com,https://chatgpt.com,http://localhost,http://127.0.0.1

# --- Local dev only ---------------------------------------------------------

PHP_CLI_SERVER_WORKERS=4
