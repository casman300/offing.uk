includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app

    level: 5

    # Read the cast arrays out of `casts()` — its declared return type is a
    # bare `array`, so without this every datetime column looks like a string.
    parseModelCastsMethod: true

    excludePaths:
        - app/**/*Test.php
